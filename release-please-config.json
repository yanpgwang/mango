{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "version-file": "VERSION",
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "skip-github-release": true,
  "pull-request-title-pattern": "chore(main): release ${version}",
  "packages": {
    ".": {
      "extra-files": [
        "sdk/go/version.go",
        {"type": "json", "path": "sdk/typescript/package.json", "jsonpath": "$.version"},
        {"type": "json", "path": "sdk/typescript/package-lock.json", "jsonpath": "$.version"},
        {"type": "json", "path": "sdk/typescript/package-lock.json", "jsonpath": "$.packages[''].version"},
        {"type": "yaml", "path": "charts/mango/Chart.yaml", "jsonpath": "$.version"},
        {"type": "yaml", "path": "charts/mango/Chart.yaml", "jsonpath": "$.appVersion"},
        "charts/mango/README.md",
        "docs/design/kubernetes-alpha.md",
        "docs/design/kubernetes-chart.md",
        "docs/guides/kubernetes.md",
        "docs/guides/release-candidates.md",
        "docs/sdk.md",
        "docs/sdk/typescript.md",
        "sdk/README.md",
        "sdk/RELEASING.md",
        "sdk/typescript/README.md"
      ]
    }
  }
}
