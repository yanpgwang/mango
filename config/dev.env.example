# Copy this file to ~/.config/mango/dev.env and chmod it 0600.
# Keep secrets empty until the corresponding feature is deliberately enabled.
# Values are loaded literally; do not add shell quotes or export statements.

# Mango uses OpenSandbox as its execution control plane. Local and CI
# OpenSandbox deployments use Docker; production uses Kubernetes/Kata.
# Compose only: OpenSandbox's host-side Unix socket; defaults to this path.
OPEN_SANDBOX_DOCKER_SOCKET=

# Anthropic-shaped Messages endpoint. Live-model tests and a real worker use
# only POST /v1/messages; keep the key empty until deliberately configured.
MANGO_MODEL_BASE_URL=
MANGO_MODEL_API_KEY=
MANGO_MODEL_ID=
MANGO_MODEL_AUTH=x-api-key

# Files API. A bucket enables the five Files routes; leave it empty to keep
# Files disabled. Static credentials are optional, but must be set together.
# PATH_STYLE and CREATE_BUCKET are normally development-only settings for MinIO.
MANGO_FILE_S3_ENDPOINT=
MANGO_FILE_S3_REGION=us-east-1
MANGO_FILE_S3_BUCKET=
MANGO_FILE_S3_ACCESS_KEY=
MANGO_FILE_S3_SECRET_KEY=
MANGO_FILE_S3_PATH_STYLE=false
MANGO_FILE_S3_CREATE_BUCKET=false
MANGO_FILE_UPLOAD_TEMP_DIR=

# Vault API. Mount a JSON keyring containing an active_key_id and one or more
# standard-base64 32-byte AES keys. The active key encrypts new values; retained
# older keys remain decrypt-only during rotation. Empty disables Vault routes.
MANGO_VAULT_KEYRING_FILE=

# OpenSandbox (self-hosted). A full URL is accepted as the domain.
OPEN_SANDBOX_DOMAIN=http://127.0.0.1:8090
OPEN_SANDBOX_API_KEY=sk-opensandbox-local-development
OPEN_SANDBOX_IMAGE=python:3.12-slim
OPEN_SANDBOX_USE_SERVER_PROXY=true
# Kubernetes/Kata qualification only. Keep the URLs on different hosts; both
# must be reachable without an egress policy and must not redirect.
OPEN_SANDBOX_KATA_NAMESPACE=opensandbox
OPEN_SANDBOX_KATA_RUNTIME_CLASS=
OPEN_SANDBOX_KATA_KUBECTL_CONTEXT=
OPEN_SANDBOX_KATA_ALLOWED_URL=
OPEN_SANDBOX_KATA_BLOCKED_URL=
